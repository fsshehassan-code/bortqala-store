# Production database (Neon/Supabase PostgreSQL recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
CORS_ORIGIN="https://YOUR-DOMAIN"

# Stripe (leave blank until your account is ready)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Shipping provider (mock works for testing)
SHIPPING_PROVIDER="mock"
SHIPPING_API_URL=""
SHIPPING_API_KEY=""
